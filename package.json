{
	"name": "dosebot",
	"main": "node_modules/expo/AppEntry.js",
	"scripts": {
		"dev": "concurrently -r 'npm:dev_a' 'npm:storybook'",
		"dev_a": "concurrently --hide 0 'npm:storybook-server'",
		"start": "expo start",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check --write .",
		"ts:check": "tsc --noEmit -p ./tsconfig.json",
		"build-dev": "eas build --profile development --platform android",
		"build-dev-local": "eas build --profile development --platform android --local --output dist/dev-build.apk",
		"build-local": "eas build --platform android --profile preview --local --output dist/build.apk",
		"build": "eas build --platform android --profile preview",
		"storybook-generate": "sb-rn-get-stories",
		"storybook": "cross-env EXPO_PUBLIC_STORYBOOK_ENABLED='true' expo start",
		"storybook-server": "storybook dev -p 6006 -c ./.storybook-web",
		"test": "jest",
		"migrate": "drizzle-kit generate",
		"prebuild": "expo prebuild -p android"
	},
	"dependencies": {
		"@expo/vector-icons": "^14.1.0",
		"@hookform/resolvers": "^5.0.1",
		"@notifee/react-native": "^9.1.8",
		"@pchmn/expo-material3-theme": "^1.3.2",
		"@react-native-masked-view/masked-view": "^0.3.2",
		"@react-navigation/drawer": "^7.3.12",
		"@react-navigation/native": "^7.1.9",
		"@react-navigation/native-stack": "^7.3.13",
		"date-fns": "^4.1.0",
		"date-fns-jalali": "4.1.0-0",
		"drizzle-orm": "^0.44.0",
		"drizzle-zod": "^0.8.2",
		"expo": "~53.0.9",
		"expo-application": "^6.1.4",
		"expo-background-fetch": "~13.1.5",
		"expo-constants": "^17.1.6",
		"expo-crypto": "^14.1.4",
		"expo-dev-client": "~5.1.8",
		"expo-font": "^13.3.1",
		"expo-linking": "~7.1.5",
		"expo-localization": "^16.1.5",
		"expo-splash-screen": "~0.30.8",
		"expo-sqlite": "^15.2.10",
		"expo-status-bar": "~2.2.3",
		"expo-task-manager": "~13.1.5",
		"expo-updates": "^0.28.13",
		"i18next": "^25.2.1",
		"intl-pluralrules": "^2.0.1",
		"lodash": "^4.17.21",
		"optics-ts": "^2.4.1",
		"react": "19.0.0",
		"react-dom": "19.0.0",
		"react-hook-form": "^7.56.4",
		"react-i18next": "^15.5.2",
		"react-native": "0.79.2",
		"react-native-gesture-handler": "~2.24.0",
		"react-native-linear-gradient": "^2.8.3",
		"react-native-mmkv": "^3.2.0",
		"react-native-paper": "^5.14.5",
		"react-native-reanimated": "3.17.5",
		"react-native-safe-area-context": "5.4.0",
		"react-native-screens": "~4.10.0",
		"react-native-vector-icons": "^10.2.0",
		"react-native-web": "~0.20.0",
		"superjson": "^2.2.2",
		"zod": "^3.25.36",
		"zod-i18n-map": "^2.27.0",
		"zustand": "^5.0.5"
	},
	"devDependencies": {
		"@babel/core": "^7.27.3",
		"@biomejs/biome": "1.9.4",
		"@expo/metro-runtime": "^5.0.4",
		"@react-native-community/datetimepicker": "8.3.0",
		"@react-native-community/slider": "4.5.6",
		"@react-native/babel-preset": "^0.79.2",
		"@storybook/addon-essentials": "^8.6.14",
		"@storybook/addon-react-native-server": "^0.0.6",
		"@storybook/builder-vite": "^8.6.14",
		"@storybook/react": "^8.6.14",
		"@storybook/react-native": "^8.6.4",
		"@storybook/react-vite": "^8.6.14",
		"@types/jest": "^29.5.14",
		"@types/lodash": "^4.17.17",
		"@types/react": "~19.0.10",
		"@types/react-native-vector-icons": "^6.4.18",
		"@vitejs/plugin-react-swc": "^3.10.0",
		"babel-loader": "^10.0.0",
		"babel-plugin-inline-import": "^3.0.0",
		"babel-plugin-react-native-web": "^0.20.0",
		"concurrently": "^9.1.2",
		"cross-env": "^7.0.3",
		"drizzle-kit": "^0.31.1",
		"expo-drizzle-studio-plugin": "^0.1.2",
		"jest": "^29.7.0",
		"jest-expo": "^53.0.5",
		"lefthook": "^1.11.13",
		"react-native-web-linear-gradient": "^1.1.2",
		"storybook": "^8.6.14",
		"typescript": "^5.8.3",
		"vite-plugin-react-native-web": "^2.1.1"
	},
	"jest": {
		"preset": "jest-expo",
		"transformIgnorePatterns": [
			"node_modules/(?!(?:.pnpm/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg))"
		]
	},
	"private": true,
	"trustedDependencies": ["@biomejs/biome", "@sentry/cli", "@swc/core"]
}
